# Vercel's packager rejects a Serverless Function whose files sit inside a
# symlinked directory ("The framework produced an invalid deployment package").
# pnpm's default isolated layout is built out of symlinks: sharp's libvips lives
# at .pnpm/@img+sharp-libvips-linux-x64@<v>/..., and the addon package reaches it
# through a symlinked sibling. Tracing that library into the function — which
# next.config.mjs must do, or every sharp route 500s — is exactly what puts
# files under a symlink.
#
# A hoisted layout lays the same packages out as real directories, npm-style, so
# the addon and its libvips are true siblings and the ELF RPATH resolves without
# a symlink in sight. It costs a larger node_modules; that is the price of
# deploying sharp on Vercel from pnpm.
node-linker=hoisted
