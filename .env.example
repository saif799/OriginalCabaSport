# Copy to .env and fill in. Every var here is required unless marked optional.

DATABASE_URL=postgres://...            # Neon

# Admin auth — see lib/auth/session.ts
ADMIN_PASSWORD=                        # the single password for /admin
AUTH_SECRET=                           # cookie signing key; rotate to log out everywhere
CRON_SECRET=                           # lets the Vercel cron call /api/status; unset = admin-only
# Generate the last two with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Delivery providers
NEXT_PUBLIC_DHD_API_KEY=
YALIDINE_API_ID=
YALIDINE_API_ID_TOKEN=
YALIDINE_API_ID_URL=
YALIDINE_FROM_WILAYA=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                         # custom domain or https://pub-<hash>.r2.dev

# Storefront
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
FB_PIXEL_ID=                           # optional; unset = no tracking script

# Meta Conversions API — the server half of the Pixel above. Both halves send
# the same event_id so Meta deduplicates them into one Purchase; unset the
# token and only the browser half reports. Events Manager > Data sources >
# your dataset > Settings > Generate access token.
CONVERSION_API_ACCESS_TOKEN=           # optional; unset = no server-side events
# Set only while testing: routes CAPI events to Events Manager > Test events
# instead of live data. Must be empty in production.
META_CAPI_TEST_EVENT_CODE=
